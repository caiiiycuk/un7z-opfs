diff --git a/CPP/7zip/Bundles/Alone7z/post.js b/CPP/7zip/Bundles/Alone7z/post.js
new file mode 100644
index 0000000..506c699
--- /dev/null
+++ b/CPP/7zip/Bundles/Alone7z/post.js
@@ -0,0 +1,21 @@
+Module.FS = FS;
+Module.OPFS = SZOPFS;
+
+// callMain() itself does not correctly await classic Asyncify (-sASYNCIFY=1)
+// completion: it invokes the instrumented wasm export directly, which
+// returns an interim/placeholder value as soon as the first unwind starts,
+// not the real result. ccall(..., {async:true}) is the one documented path
+// that checks Asyncify.currData and chains into Asyncify.whenDone() when an
+// unwind actually happened -- so run main() through ccall by hand-building
+// argc/argv the same way callMain() does internally.
+Module.callMain = async function (args) {
+  var argsWithProgName = [thisProgram].concat(args);
+  var argv = stackAlloc((argsWithProgName.length + 1) * 4);
+  var p = argv;
+  for (var i = 0; i < argsWithProgName.length; i++) {
+    HEAPU32[p >> 2] = stringToUTF8OnStack(argsWithProgName[i]);
+    p += 4;
+  }
+  HEAPU32[p >> 2] = 0;
+  return ccall('main', 'number', ['number', 'number'], [argsWithProgName.length, argv], { async: true });
+};
